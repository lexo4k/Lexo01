# Copie para .env e preencha localmente. Nunca envie chaves reais ao GitHub.
LUMEN_ACCESS_TOKEN=gere-um-token-longo-e-aleatorio
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Gateway multi-provedor: JSON configurado no ambiente do servidor.
# api_key_env aponta para o NOME da variável secreta, nunca para o valor da chave.
# Os clientes usam model="provedor/modelo" na API NEXORA.
NEXORA_PROVIDERS={"openai":{"base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY","models":["gpt-4.1-mini"],"fallbacks":["groq/llama-3.3-70b-versatile"]},"groq":{"base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY","models":["llama-3.3-70b-versatile"]}}
NEXORA_DEFAULT_PROVIDER=openai
GROQ_API_KEY=
LUMEN_DB_PATH=./data/lumen.db
# Opcional: PostgreSQL gerenciado para memória durável em hospedagem
DATABASE_URL=
